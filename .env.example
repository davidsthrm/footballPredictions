# Kopieren nach .env (gitignored).

# Web-App auf Cloudflare Pages (fussball webapp --deploy, läuft im täglichen Job mit)
# Token: Cloudflare › Profil › API-Tokens › Benutzerdefiniert: Konto › Cloudflare Pages › Bearbeiten
#        (für den Zugangsschutz zusätzlich: Konto › Access: Apps und Richtlinien › Bearbeiten)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# FUSSBALL_PAGES_PROJECT=tippspiel
