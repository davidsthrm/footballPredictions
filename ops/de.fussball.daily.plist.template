<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.fussball.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/ops/daily.sh</string>
    </array>
    <!-- täglich 08:00; war der Mac aus/im Ruhezustand, läuft der Job beim Aufwachen nach -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>__REPO__/data/logs/launchd.err</string>
</dict>
</plist>
